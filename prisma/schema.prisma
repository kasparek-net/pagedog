generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "workerd"
  moduleFormat    = "esm"
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Watch {
  id            String    @id @default(cuid())
  userId        String
  label         String
  url           String
  selector      String
  notifyEmail   String
  lastValue     String?
  lastHash      String?
  lastCheckedAt DateTime?
  lastError     String?
  imageUrl      String?
  faviconUrl    String?
  isActive      Boolean   @default(true)
  intervalMinutes Int     @default(60)
  conditionType   String  @default("change")
  conditionValue  String?
  failStreak    Int       @default(0)
  cloudBlocked  Boolean   @default(false)
  snoozedUntil  DateTime?
  lastCheckedVia String?  // "agent" | "cloud"
  createdAt     DateTime  @default(now())
  changes       Change[]
  checks        Check[]

  @@index([userId])
  @@index([isActive])
}

model Change {
  id         String   @id @default(cuid())
  watchId    String
  oldValue   String
  newValue   String
  detectedAt DateTime @default(now())
  watch      Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
}

model SignInCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Check {
  id        String   @id @default(cuid())
  watchId   String
  status    String   // "same" | "changed" | "error"
  value     String?
  error     String?
  durationMs Int?
  checkedAt DateTime @default(now())
  watch     Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId, checkedAt])
}

// A page the server cannot fetch itself, queued for the local agent so the
// element picker still works on shops that block our datacenter IP.
model PreviewJob {
  id        String   @id @default(cuid())
  url       String
  html      String?
  error     String?
  createdAt DateTime @default(now())
  doneAt    DateTime?

  @@index([doneAt, createdAt])
}

// Single row ("agent"): when the local agent last polled, so the app can tell
// people their agent-handled watches have silently stopped.
model AgentStatus {
  id              String    @id
  lastSeenAt      DateTime
  staleNotifiedAt DateTime?
}

// Per-person preferences, keyed by the sign-in email (there is no user table).
model UserSettings {
  email     String   @id
  ntfyTopic String?
  updatedAt DateTime @updatedAt
}
