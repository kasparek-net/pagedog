{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagedog",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pagedog"
    }
  ],
  // Cloud fallback checks. The local agent does the work while it is alive;
  // this replaces the GitHub Actions schedule that used to call the cron route.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
